#!/usr/bin/env python3
"""trmx-agent — LLM task loop for the TRMX bridge (revival build).

Run by the bridge as a job:  trmx-agent --task <task_id>
Reads ~/.trmx/agent/tasks/<task_id>.json (the instruction), drives the
configured LLM backend (same ai.json as trmx-ai, via trmx_ai_lib), and
executes a FIXED tool menu against the bridge's local authenticated API.

Stdout is the event stream — one JSON object per line:
  backend / plan / action / result / confirm-needed / done / failed
The app renders it from the job's output stream (GET /v1/jobs/{id}/output).

Trust model (same spirit as ADR-014): the model output is UNTRUSTED —
parsed as data only, strict whitelist validation, size caps, fail loud.
Destructive actions pause for the user's explicit allow/deny
(~/.trmx/agent/decisions/<task_id>.json, written by the bridge's
POST /v1/agent/tasks/<id>/confirm).

The pairing token is read from ~/.trmx/bridge.json solely to authenticate
the agent's own API calls (like the `trmx` CLI does). It is never printed,
never logged, never placed in the event stream, and the agent has no way
to mint, change, or read it back through the API.

Exit codes: 0 done · 2 failed (the failed event carries the reason).
Stdlib only (ADR-002 rule).
"""

from __future__ import annotations

import http.client
import io
import json
import os
import re
import signal
import sys
import time
import urllib.parse
from contextlib import redirect_stderr
from pathlib import Path

_here = Path(__file__).resolve().parent
sys.path.insert(0, str(_here))
sys.path.insert(0, str(_here.parent))  # installed layout: lib at home root
from trmx_ai_lib import (call_backend, extract_json, home_dir, resolve_cli,
                         resolve_http, resolve_mode)  # noqa: E402

TRMX_AGENT_VERSION = "0.1.0"

MAX_STEPS = int(os.environ.get("TRMX_AGENT_MAX_STEPS", "25"))
TASK_TIMEOUT_S = int(os.environ.get("TRMX_AGENT_TASK_TIMEOUT_S", "1800"))
CONFIRM_TIMEOUT_S = 600
STEP_JOB_WAIT_S = 1500
MAX_HISTORY_CHARS = 6000
MAX_ARG_BYTES = 8000

# Second net under the tool risk_tier check: verbs that always confirm.
DESTRUCTIVE_RE = re.compile(r"\b(rm|delete|kill|format|mkfs|dd|shred)\b",
                            re.IGNORECASE)

TOOL_MENU = ("submit_tool", "list_jobs", "job_output", "list_files",
             "service_action", "cancel_job")


# ---------------------------------------------------------------- events

def emit(obj: dict) -> None:
    sys.stdout.write(json.dumps(obj, ensure_ascii=False) + "\n")
    sys.stdout.flush()


def note(text: str) -> None:
    """Plain progress line. The app renders non-JSON stdout lines as muted
    notes -- so the chat can show life DURING a long model call instead of
    staying blank until the step completes (device lesson, 2026-10-19:
    the server logs looked alive while the chat showed nothing)."""
    sys.stdout.write(text + "\n")
    sys.stdout.flush()


def _sigterm(signum, frame):  # noqa: ARG001
    raise AgentCancelled()


signal.signal(signal.SIGTERM, _sigterm)


class AgentError(Exception):
    pass


class AgentCancelled(BaseException):
    pass


class TaskTimeout(AgentError):
    pass


def _task_timeout(signum, frame):  # noqa: ARG001
    raise TaskTimeout("task timed out")


# ---------------------------------------------------------------- bridge client

class Bridge:
    """Minimal authenticated client for the local bridge (stdlib only)."""

    def __init__(self, home: Path):
        self.home = home
        cfg = json.loads((home / "bridge.json").read_text(encoding="utf-8"))
        token = cfg.get("token")
        if not token:
            raise AgentError("no pairing token in bridge.json — re-pair first")
        self.token = token
        self.port = int(cfg.get("port", 27342))

    def call(self, method: str, path: str, body: dict | None = None,
             timeout: int = 30) -> tuple[int, dict | str]:
        headers = {"Authorization": f"Bearer {self.token}",
                   "X-TRMX-Protocol": "1",
                   "Content-Type": "application/json"}
        raw = json.dumps(body or {}).encode("utf-8")
        conn = http.client.HTTPConnection("127.0.0.1", self.port,
                                          timeout=timeout)
        try:
            conn.request(method, path, body=raw, headers=headers)
            resp = conn.getresponse()
            data = resp.read()
        finally:
            conn.close()
        ctype = resp.getheader("Content-Type", "")
        if "application/json" in ctype and data:
            try:
                return resp.status, json.loads(data.decode("utf-8"))
            except ValueError:
                pass
        return resp.status, data.decode("utf-8", "replace")

    def check(self, method: str, path: str, body: dict | None = None,
              timeout: int = 30) -> dict:
        st, data = self.call(method, path, body, timeout)
        if not (200 <= st < 300):
            code = data.get("code") if isinstance(data, dict) else None
            msg = (data.get("message") if isinstance(data, dict)
                   else str(data)[:300])
            raise AgentError(f"{method} {path} -> HTTP {st}"
                             + (f" {code}: {msg}" if code else f": {msg}"))
        if not isinstance(data, dict):
            raise AgentError(f"{method} {path} -> non-JSON response")
        return data

    def sse_text(self, path: str, timeout: int = 120) -> str:
        """GET an SSE stream to completion; return concatenated
        stdout+stderr text."""
        headers = {"Authorization": f"Bearer {self.token}",
                   "X-TRMX-Protocol": "1"}
        conn = http.client.HTTPConnection("127.0.0.1", self.port,
                                          timeout=timeout)
        chunks: list[str] = []
        try:
            conn.request("GET", path, headers=headers)
            resp = conn.getresponse()
            if resp.status != 200:
                raise AgentError(f"GET {path} -> HTTP {resp.status}")
            event: str | None = None
            buf: list[str] = []
            for raw_line in resp:
                line = raw_line.decode("utf-8", "replace").rstrip("\n")
                if line == "":
                    if event in ("stdout", "stderr") and buf:
                        try:
                            payload = json.loads("".join(buf))
                            text = payload.get("text", "")
                            if isinstance(text, str):
                                chunks.append(text)
                        except ValueError:
                            pass
                    event, buf = None, []
                elif line.startswith("event:"):
                    event = line[6:].strip()
                elif line.startswith("data:"):
                    buf.append(line[5:].strip())
        finally:
            conn.close()
        return "".join(chunks)


# ---------------------------------------------------------------- strict action validation

def _scalar_ok(v) -> bool:
    return v is None or isinstance(v, (str, int, float, bool))


def _check_args(args, depth: int = 0) -> None:
    if not isinstance(args, dict):
        raise ValueError("args must be a JSON object")
    if depth > 2:
        raise ValueError("args nested too deep")
    for k, v in args.items():
        if not isinstance(k, str) or not k:
            raise ValueError("arg names must be non-empty strings")
        if isinstance(v, (dict, list)):
            if isinstance(v, dict):
                _check_args(v, depth + 1)
            else:
                if len(v) > 64:
                    raise ValueError("arg lists capped at 64 items")
                for item in v:
                    if isinstance(item, (dict, list)):
                        raise ValueError("arg lists must be flat")
                    if not _scalar_ok(item):
                        raise ValueError("arg values must be scalars")
        elif not _scalar_ok(v):
            raise ValueError("arg values must be scalars")


_OP_KEYS = {
    "say": {"op", "text"},
    "do": {"op", "tool", "args", "describe"},
    "done": {"op", "summary"},
    "cannot": {"op", "reason"},
}


def validate_action(obj: dict) -> dict:
    """Strict whitelist validation of one LLM turn (untrusted input)."""
    if not isinstance(obj, dict):
        raise ValueError("action must be a JSON object")
    op = obj.get("op")
    if op not in _OP_KEYS:
        raise ValueError(f"unknown op {op!r} — want one of say|do|done|cannot")
    unknown = set(obj) - _OP_KEYS[op]
    if unknown:
        raise ValueError(f"unknown keys for op {op}: {sorted(unknown)}")
    if op == "say":
        t = obj.get("text")
        if not isinstance(t, str) or not (1 <= len(t) <= 500):
            raise ValueError("say.text must be 1..500 chars")
    elif op == "done":
        s = obj.get("summary")
        if not isinstance(s, str) or not (1 <= len(s) <= 1000):
            raise ValueError("done.summary must be 1..1000 chars")
    elif op == "cannot":
        r = obj.get("reason")
        if not isinstance(r, str) or not (1 <= len(r) <= 500):
            raise ValueError("cannot.reason must be 1..500 chars")
    else:  # do
        tool = obj.get("tool")
        if tool not in TOOL_MENU:
            raise ValueError(f"unknown tool {tool!r} — fixed menu only")
        _check_args(obj.get("args"))
        blob = json.dumps(obj.get("args"), ensure_ascii=False)
        if len(blob) > MAX_ARG_BYTES:
            raise ValueError("args exceed 8000 bytes")
        d = obj.get("describe")
        if not isinstance(d, str) or not (1 <= len(d) <= 300):
            raise ValueError("do.describe must be 1..300 chars")
        a = obj["args"]
        if tool == "submit_tool":
            tid = a.get("tool")
            if not isinstance(tid, str) or not tid:
                raise ValueError("submit_tool needs args.tool (a tool id)")
            if tid == "agent":
                raise ValueError("the agent tool cannot submit itself")
        elif tool in ("job_output", "cancel_job"):
            if not isinstance(a.get("job_id"), str) or not a["job_id"]:
                raise ValueError(f"{tool} needs args.job_id (a string)")
        elif tool == "service_action":
            if not isinstance(a.get("service_id"), str) or not a["service_id"]:
                raise ValueError("service_action needs args.service_id")
            if a.get("action") not in ("start", "stop", "restart"):
                raise ValueError("service_action.action must be "
                                 "start|stop|restart")
    return obj


def is_destructive(tool: str, args: dict, describe: str, bridge: Bridge) -> str | None:
    """Why this action needs confirmation, or None if it is safe."""
    if DESTRUCTIVE_RE.search(describe) or DESTRUCTIVE_RE.search(
            json.dumps(args, ensure_ascii=False)):
        return "destructive"
    if tool == "submit_tool":
        try:
            info = bridge.check("GET", f"/v1/tools/{args['tool']}")
        except AgentError:
            return "risk-tier"  # unknown tool: fail closed
        tier = info.get("schema", {}).get("risk_tier", "safe")
        if tier in ("confirm", "destructive"):
            return "risk-tier"
    return None


# ---------------------------------------------------------------- prompt

PROMPT_TEMPLATE = """You are the TRMX agent — an operator that carries out the user's instruction on their own Termux device by calling bridge tools. Never invent tools, files, or results. Reply with EXACTLY ONE JSON object per turn, no prose, no markdown fences.

Shapes (strict — unknown keys are rejected):
{{"op":"say","text":"<short progress message for the user, plain words>"}}
{{"op":"do","tool":"<one of the tools below>","args":{{...}},"describe":"<one plain sentence saying what this will do>"}}
{{"op":"done","summary":"<plain summary of what was accomplished>"}}
{{"op":"cannot","reason":"<plain reason it cannot be done>"}}

Rules:
- One action per turn. Use each action's result before choosing the next.
- args must match the tool's shape exactly (below). Keep strings short.
- Destructive actions (deleting, killing, or tools marked confirm/destructive) pause for the user's approval automatically — propose them normally; the system handles the pause.
- If the instruction is already satisfied, answer done. If no tool can do it, answer cannot.

Tool menu:
- submit_tool {{"tool":"<tool id>","args":{{...}},"name"?: "<short job name>"}} — run a registered tool. Available tools: {tools}
- list_jobs {{"status"?: "active", "limit"?: 1..50}} — recent jobs
- job_output {{"job_id": "...", "tail_chars"?: 1..8000}} — last output of a job
- list_files {{"path"?: "~"}} — list a directory
- service_action {{"service_id": "...", "action": "start"|"stop"|"restart"}}
- cancel_job {{"job_id": "..."}} — cancel a running job

User instruction: {instruction}

History so far:
{history}

Reply with exactly one JSON object."""


# ---------------------------------------------------------------- the loop

class Agent:
    def __init__(self, home: Path, task_id: str):
        self.home = home
        self.task_id = task_id
        tpath = home / "agent" / "tasks" / f"{task_id}.json"
        try:
            self.task = json.loads(tpath.read_text(encoding="utf-8"))
        except Exception as e:  # noqa: BLE001
            raise AgentError(f"cannot read task file {tpath}: {e}")
        self.instruction = self.task.get("instruction", "")
        if not isinstance(self.instruction, str) or not self.instruction.strip():
            raise AgentError("task has no instruction")
        self.bridge = Bridge(home)
        self.history: list[str] = []
        self.step = 0
        self.deadline = time.monotonic() + TASK_TIMEOUT_S
        self.child_job_id: str | None = None
        self.consec_failures = 0
        self.parse_failures = 0

    # -- task file ------------------------------------------------

    def _task_path(self) -> Path:
        return self.home / "agent" / "tasks" / f"{self.task_id}.json"

    def _save_task(self, status: str, summary: str = "", error: str = "") -> None:
        self.task["status"] = status
        if summary:
            self.task["summary"] = summary
        if error:
            self.task["error"] = error
        p = self._task_path()
        tmp = p.with_suffix(".json.tmp")
        tmp.write_text(json.dumps(self.task, ensure_ascii=False, indent=2),
                       encoding="utf-8")
        os.replace(tmp, p)

    # -- tools ----------------------------------------------------

    def _remaining(self) -> float:
        remaining = self.deadline - time.monotonic()
        if remaining <= 0:
            raise TaskTimeout("task timed out")
        return remaining

    def _cancel_child_job(self) -> None:
        if self.child_job_id is None:
            return
        job_id, self.child_job_id = self.child_job_id, None
        try:
            self.bridge.check("POST", f"/v1/jobs/{job_id}/cancel", {}, timeout=2)
        except Exception as e:  # noqa: BLE001 — cleanup must still let the agent exit
            note(f"could not cancel child job {job_id}: {e}")

    def _wait_job(self, job_id: str) -> dict:
        deadline = time.monotonic() + STEP_JOB_WAIT_S
        while time.monotonic() < deadline:
            remaining = self._remaining()
            job = self.bridge.check("GET", f"/v1/jobs/{job_id}",
                                    timeout=min(30, remaining))
            self._remaining()
            if job.get("status") in ("COMPLETED", "FAILED", "CANCELLED", "LOST"):
                return job
            time.sleep(min(2, self._remaining()))
        self._remaining()
        raise AgentError(f"timed out waiting for job {job_id}")

    def tool_submit_tool(self, args: dict) -> str:
        payload = {"type": "tool", "tool": args["tool"], "args": args.get("args", {})}
        if args.get("name"):
            payload["name"] = args["name"]
        remaining = self._remaining()
        # Defer cancellation until the submitted job id is recorded.
        mask = signal.pthread_sigmask(signal.SIG_BLOCK,
                                      {signal.SIGTERM, signal.SIGINT, signal.SIGALRM})
        try:
            resp = self.bridge.check("POST", "/v1/jobs", payload,
                                     timeout=min(30, remaining))
            job_id = self.child_job_id = resp["job_id"]
        finally:
            signal.pthread_sigmask(signal.SIG_SETMASK, mask)
        try:
            job = self._wait_job(job_id)
            self.child_job_id = None  # terminal: no running child remains
        finally:
            self._cancel_child_job()
        out = self.bridge.sse_text(
            f"/v1/jobs/{job_id}/output?follow=0&stream=both",
            timeout=min(120, self._remaining()))
        tail = out[-4000:]
        status = job.get("status")
        if status != "COMPLETED":
            raise AgentError(
                f"tool job {job_id} ended {status}"
                + (f": {tail[-500:]}" if tail else ""))
        return f"job {job_id} completed. output tail:\n{tail or '(no output)'}"

    def tool_list_jobs(self, args: dict) -> str:
        q = {}
        if args.get("status"):
            q["status"] = args["status"]
        if args.get("limit"):
            q["limit"] = args["limit"]
        qs = ("?" + urllib.parse.urlencode(q)) if q else ""
        data = self.bridge.check("GET", f"/v1/jobs{qs}")
        jobs = data.get("jobs", [])
        lines = [f"{j['job_id']} {j.get('name','')} [{j.get('status')}]"
                 for j in jobs[:20]]
        return "\n".join(lines) or "(no jobs)"

    def tool_job_output(self, args: dict) -> str:
        tail_chars = args.get("tail_chars", 4000)
        if not isinstance(tail_chars, int) or not (1 <= tail_chars <= 8000):
            raise AgentError("tail_chars must be 1..8000")
        out = self.bridge.sse_text(
            f"/v1/jobs/{args['job_id']}/output?follow=0&stream=both")
        return out[-tail_chars:] or "(no output)"

    def tool_list_files(self, args: dict) -> str:
        path = args.get("path", "~")
        data = self.bridge.check(
            "GET", f"/v1/files?path={urllib.parse.quote(str(path))}")
        entries = data.get("entries", data.get("files", []))
        lines = [f"{e.get('type','?')[:4]} {e.get('size','')} {e.get('name','')}"
                 for e in entries[:50]]
        return "\n".join(lines) or "(empty)"

    def tool_service_action(self, args: dict) -> str:
        data = self.bridge.check(
            "POST", f"/v1/services/{args['service_id']}/{args['action']}", {})
        return json.dumps(data, ensure_ascii=False)[:1000]

    def tool_cancel_job(self, args: dict) -> str:
        data = self.bridge.check(
            "POST", f"/v1/jobs/{args['job_id']}/cancel", {})
        return f"cancel requested: {data.get('status')}"

    # -- confirm --------------------------------------------------

    def _pending_path(self) -> Path:
        return self.home / "agent" / "pending" / f"{self.task_id}.json"

    def _decision_path(self) -> Path:
        return self.home / "agent" / "decisions" / f"{self.task_id}.json"

    def ask_confirm(self, tool: str, args: dict, describe: str,
                    why: str) -> bool:
        pending = {"task_id": self.task_id, "step": self.step,
                   "tool": tool, "args": args, "describe": describe,
                   "why": why, "requested_at": time.strftime(
                       "%Y-%m-%dT%H:%M:%SZ", time.gmtime())}
        pp = self._pending_path()
        pp.parent.mkdir(parents=True, exist_ok=True)
        pp.write_text(json.dumps(pending, ensure_ascii=False), encoding="utf-8")
        emit({"t": "confirm-needed", "step": self.step, "describe": describe,
              "tool": tool, "why": why})
        dp = self._decision_path()
        deadline = time.monotonic() + CONFIRM_TIMEOUT_S
        while time.monotonic() < deadline:
            self._remaining()
            if dp.is_file():
                try:
                    dec = json.loads(dp.read_text(encoding="utf-8"))
                except ValueError:
                    dec = {}
                try:
                    pp.unlink(missing_ok=True)
                    dp.unlink(missing_ok=True)
                except OSError:
                    pass
                return dec.get("decision") == "allow"
            time.sleep(min(1, self._remaining()))
        self._remaining()
        try:
            pp.unlink(missing_ok=True)
        except OSError:
            pass
        return False  # silence is denial

    # -- main loop ------------------------------------------------

    def run(self) -> int:
        ai_path = self.home / "ai.json"
        if not ai_path.is_file():
            emit({"t": "failed",
                  "error": "AI backend not configured — open Settings → AI "
                           "to choose the local model or a cloud API first"})
            self._save_task("failed", error="ai backend not configured")
            return 2
        try:
            cfg = json.loads(ai_path.read_text(encoding="utf-8"))
        except ValueError as e:
            emit({"t": "failed", "error": f"ai.json is not valid JSON: {e}"})
            self._save_task("failed", error="ai.json invalid")
            return 2

        # Resolve the backend label WITHOUT spending a model call: this also
        # fails fast (via die()) when the config is broken or the API key
        # is missing, so the user gets a clear error before step 1.
        buf = io.StringIO()
        try:
            with redirect_stderr(buf):
                mode = resolve_mode(cfg)
                if mode == "cli":
                    command, _ = resolve_cli(cfg, None)
                    backend = {"mode": "cli",
                               "model": " ".join(command[:2])}
                else:
                    spec = resolve_http(cfg, None)
                    backend = {"mode": "http_api",
                               "model": f"{spec['provider']}/{spec['model']}"}
        except SystemExit:
            err = buf.getvalue().strip().splitlines()
            msg = err[-1] if err else "backend misconfigured"
            msg = re.sub(r"^trmx:\s*", "", msg)
            emit({"t": "failed", "error": msg})
            self._save_task("failed", error=msg)
            return 2
        emit({"t": "backend", "mode": backend["mode"], "model": backend["model"]})

        try:
            tools = self.bridge.check("GET", "/v1/tools").get("tools", [])
        except AgentError as e:
            emit({"t": "failed", "error": f"cannot list tools: {e}"})
            self._save_task("failed", error=str(e))
            return 2
        tools_line = ", ".join(
            f"{s.get('id')} ({(s.get('description') or '')[:60]}"
            f"[{s.get('risk_tier', 'safe')}])"
            for t in tools for s in [t.get("schema", {})]
            if s.get("id") != "agent") or "(none)"

        while self.step < MAX_STEPS and time.monotonic() < self.deadline:
            self.step += 1
            history = "\n".join(self.history[-8:]) or "(nothing yet)"
            prompt = PROMPT_TEMPLATE.format(
                tools=tools_line, instruction=self.instruction, history=history)
            note(f"step {self.step}: asking the model -- on this phone a "
                 "slow local model can take a minute or two per step")
            buf = io.StringIO()
            try:
                with redirect_stderr(buf):
                    text, _ = call_backend(cfg, None, prompt, tool="trmx-agent")
                self._remaining()
            except SystemExit:
                err = buf.getvalue().strip().splitlines()
                msg = err[-1] if err else "backend failed"
                return self.fail(f"backend error at step {self.step}: "
                                 f"{re.sub(r'^trmx:\\s*', '', msg)}")
            try:
                # §2-M3: prefer the LAST block that validates as an
                # action — a chatty model may put a prose/example object
                # before the action it actually means.
                action = validate_action(
                    extract_json(text, validator=validate_action))
                self.parse_failures = 0
            except ValueError as e:
                # A small local model often wraps the JSON in prose or
                # breaks the shape. One corrective retry (with the rule
                # restated in history) instead of dying on the spot --
                # two bad replies in a row still fail the task.
                self.parse_failures += 1
                if self.parse_failures >= 2:
                    return self.fail(f"model output rejected at step "
                                     f"{self.step}: {e}")
                note(f"step {self.step}: the model's reply was not valid "
                     "JSON -- asking again")
                self.history.append(
                    "system: your last reply was not one valid JSON object. "
                    "Reply with exactly one JSON object in the required "
                    "shape, no prose, no markdown fences.")
                continue
            op = action["op"]
            if op == "say":
                emit({"t": "result", "step": self.step, "ok": True,
                      "excerpt": action["text"]})
                self.history.append(f"step {self.step}: said "
                                    f"“{action['text'][:120]}”")
                continue
            if op == "done":
                emit({"t": "done", "summary": action["summary"]})
                self._save_task("done", summary=action["summary"])
                return 0
            if op == "cannot":
                return self.fail(f"agent cannot do this: {action['reason']}")

            # op == "do"
            tool, args, describe = (action["tool"], action["args"],
                                    action["describe"])
            emit({"t": "plan", "step": self.step, "thought": describe,
                  "describe": describe})
            why = is_destructive(tool, args, describe, self.bridge)
            if why:
                if not self.ask_confirm(tool, args, describe, why):
                    return self.fail(
                        f"action denied by user at step {self.step}: {describe}")
            emit({"t": "action", "step": self.step, "tool": tool,
                  "describe": describe})
            try:
                self._remaining()
                result = getattr(self, f"tool_{tool}")(args)
                self._remaining()
            except TaskTimeout:
                raise
            except AgentError as e:
                result = f"FAILED: {e}"
                self.consec_failures += 1
            except Exception as e:  # noqa: BLE001 — never let one step kill the loop silently
                result = f"FAILED: internal error: {e}"
                self.consec_failures += 1
            else:
                self.consec_failures = 0
            excerpt = result[-1500:]
            emit({"t": "result", "step": self.step,
                  "ok": not result.startswith("FAILED"), "excerpt": excerpt})
            self.history.append(f"step {self.step}: {describe[:120]} → "
                                f"{excerpt[:200]}")
            if len("\n".join(self.history)) > MAX_HISTORY_CHARS:
                self.history = self.history[-6:]
            if self.consec_failures >= 2:
                return self.fail("two consecutive action failures — stopping")
        if self.step >= MAX_STEPS:
            return self.fail(f"step cap reached ({MAX_STEPS}) without finishing")
        return self.fail("task timed out")

    def fail(self, error: str) -> int:
        emit({"t": "failed", "error": error})
        try:
            self._save_task("failed", error=error)
        except Exception:  # noqa: BLE001
            pass
        return 2


def main(argv: list[str]) -> int:
    import argparse
    ap = argparse.ArgumentParser(prog="trmx-agent")
    ap.add_argument("--task", required=True, help="agent task id")
    ap.add_argument("--version", action="version",
                    version=f"trmx-agent {TRMX_AGENT_VERSION}")
    args = ap.parse_args(argv)
    home = home_dir()
    try:
        agent = Agent(home, args.task)
    except AgentError as e:
        emit({"t": "failed", "error": str(e)})
        return 2
    try:
        try:
            signal.signal(signal.SIGALRM, _task_timeout)
            signal.setitimer(signal.ITIMER_REAL, max(0.001, agent._remaining()))
            return agent.run()
        finally:
            signal.setitimer(signal.ITIMER_REAL, 0)
            agent._cancel_child_job()
            agent._pending_path().unlink(missing_ok=True)
    except TaskTimeout:
        return agent.fail("task timed out")
    except (AgentCancelled, KeyboardInterrupt):
        return agent.fail("cancelled by user")


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
