MAX_STEPS = int(os.environ.get("TRMX_AGENT_MAX_STEPS", "25"))
TASK_TIMEOUT_S = int(os.environ.get("TRMX_AGENT_TASK_TIMEOUT_S", "1800"))
CONFIRM_TIMEOUT_S = int(os.environ.get("TRMX_AGENT_CONFIRM_TIMEOUT_S", "600"))
STEP_JOB_WAIT_S = 1500
MAX_HISTORY_CHARS = 6000
HISTORY_TOOL_FULL_CHARS = 4000   # last tool output kept (nearly) full
MAX_ARG_BYTES = 8000

# Second net under the tool risk_tier check: verbs that always confirm.
DESTRUCTIVE_RE = re.compile(r"\b(rm|delete|kill|format|mkfs|dd|shred)\b",
                            re.IGNORECASE)

# Multi-token destructive patterns the single-verb list cannot express
# (audit §4-M4): moving a file INTO a system location destroys the
# original just as surely as rm; a recursive chmod/chown rewrites
# permissions wholesale; and stopping/restarting a service is a
# destructive action against its availability. These scan the same
# text as DESTRUCTIVE_RE (the LLM's describe + the args JSON).
DESTRUCTIVE_PATTERNS = [
    # mv <anything> /(dev|system|usr|etc|bin|sbin|proc|sys)/… or into $PREFIX
    re.compile(r"\bmv\b[^\n]*\s/(?:dev|system|usr|etc|bin|sbin|proc|sys)"
               r"(?:/|\s|$)", re.IGNORECASE),
    re.compile(r"\bmv\b[^\n]*\s/data/data/com\.termux/files/usr(?:/|\s|$)",
               re.IGNORECASE),
    # chmod/chown/chgrp -R / --recursive (incl. combined flags like -Rf)
    re.compile(r"\b(?:chmod|chown|chgrp)\b[^\n]*\s--recursive\b",
               re.IGNORECASE),
    re.compile(r"\b(?:chmod|chown|chgrp)\b[^\n]*\s-[A-Za-z]*R[A-Za-z]*"
               r"(?:\s|$)", re.IGNORECASE),
    # service stop/restart phrasing, either word order
    re.compile(r"\b(?:sv|systemctl|service)\b[^\n]*"
               r"\b(?:stop|restart|down)\b", re.IGNORECASE),
    re.compile(r"\b(?:stop|restart)\b[^\n]*\bservice\b", re.IGNORECASE),
]


def action_hash(task_id: str, step: int, tool: str, args: dict) -> str:
    """Binding hash for one confirm (audit §4-M3): sha256 over the
    canonical JSON of {task_id, step, tool, args}. A decision is valid
    ONLY for the action this hash names. The bridge computes the same
    hash (agent_action_hash in trmx-bridge.py — keep them in sync)."""
    canon = json.dumps({"task_id": task_id, "step": step, "tool": tool,
                        "args": args},
                       sort_keys=True, ensure_ascii=False,
                       separators=(",", ":"))
    return hashlib.sha256(canon.encode("utf-8")).hexdigest()

TOOL_MENU = ("submit_tool", "list_jobs", "job_output", "list_files",
             "service_action", "cancel_job")


# ---------------------------------------------------------------- events

def emit(obj: dict) -> None:
    sys.stdout.write(json.dumps(obj, ensure_ascii=False) + "\n")
    sys.stdout.flush()


def note(text: str) -> None:
    """Plain progress line. The app renders non-JSON stdout lines as muted
    notes -- so the chat can show life DURING a long model call instead of
    staying blank until the step completes (device lesson, 2026-10-19:
    the server logs looked alive while the chat showed nothing)."""
    sys.stdout.write(text + "\n")
    sys.stdout.flush()


