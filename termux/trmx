#!/usr/bin/env python3
"""trmx — control CLI for the TRMX bridge (Phase 3).

Runnable even when the bridge is down, so `RUN_COMMAND` intents from the
Android app can drive it (docs/CONTROL-PLANE.md):

  trmx init                 create ~/.trmx (no secrets)
  trmx pair TOKEN [--force] store the app-generated token (0600);
                            a TOKEN starting with '-' works too (rescued
                            before argparse can mistake it for a flag)
  trmx pair [--stdin]       same, but read the token from stdin so it
                            never lands in shell history (audit §4-M2):
                            `trmx pair --stdin` then paste + Enter, or
                            pipe it in. With no TOKEN argument, stdin is
                            used automatically.
  trmx pair-link [--print]  open TRMX with this bridge's token (one-command connect)
  trmx unpair               remove the token
  trmx token [--show]       print the token (masked unless --show)
  trmx start [--port N]     start the bridge detached (nohup-style)
  trmx stop                 stop it (API stop, then SIGTERM fallback)
  trmx status               is the port answering?
  trmx doctor               self-check: python, token, port, API (JSON on stdout)
  trmx pid                  print the bridge PID from the pidfile
  trmx enable-boot          install the Termux:Boot autostart script
  trmx enable-service       install the runit service (needs termux-services)
  trmx version              print CLI + bridge versions

Env overrides (mainly for tests / non-Termux hosts):
  TRMX_HOME     state dir       (default ~/.trmx)
  TRMX_PREFIX   Termux $PREFIX  (default /data/data/com.termux/files/usr)
  TRMX_BOOT_DIR Termux boot dir (default ~/.termux/boot)
"""

from __future__ import annotations

import argparse
import json
import os
import re
import socket
import subprocess
import sys
import time
from pathlib import Path

TRMX_CLI_VERSION = "0.3.0"

HERE = Path(__file__).resolve().parent
BRIDGE = HERE / "trmx-bridge.py"


def trmx_home() -> Path:
    return Path(os.environ.get("TRMX_HOME", str(Path.home() / ".trmx"))).expanduser()


def config_path() -> Path:
    return trmx_home() / "bridge.json"


def load_config() -> dict:
    p = config_path()
    if p.exists():
        try:
            return json.loads(p.read_text("utf-8"))
        except Exception as e:  # noqa: BLE001
            sys.exit(f"trmx: unreadable config {p}: {e}")
    return {}


def save_config(cfg: dict) -> None:
    p = config_path()
    p.parent.mkdir(parents=True, exist_ok=True)
    fd = os.open(p, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w", encoding="utf-8") as f:
        json.dump(cfg, f, indent=2)
        f.write("\n")
    os.chmod(p, 0o600)


def port_open(port: int, timeout: float = 0.5) -> bool:
    try:
        with socket.create_connection(("127.0.0.1", port), timeout=timeout):
            return True
    except OSError:
        return False


def cmd_init(args) -> int:
    home = trmx_home()
    for d in ("logs", "tools", "bin"):
        (home / d).mkdir(parents=True, exist_ok=True)
    print(f"initialized {home}")
    return 0


def _read_token_stdin() -> str:
    """Read the pairing token from stdin (audit §4-M2): a token passed
    as a command-line argument lands in the shell's history file on
    disk; a token typed/piped on stdin does not. On a terminal the
    prompt goes to stderr and the input is not echoed (getpass); when
    piped, one line is read."""
    if sys.stdin.isatty():
        import getpass
        return getpass.getpass("Token (input hidden): ", stream=sys.stderr).strip()
    return sys.stdin.readline().strip()


def cmd_pair(args) -> int:
    token = args.token
    if getattr(args, "stdin", False) or not token:
        token = _read_token_stdin()
        if not token:
            sys.exit("trmx pair: no token on stdin — usage: "
                     "`trmx pair --stdin` (then paste the token), "
                     "or `trmx pair TOKEN`")
    else:
        print("trmx pair: note — a token given as an argument can land "
              "in your shell history; `trmx pair --stdin` avoids that",
              file=sys.stderr)
    if not token or len(token) < 20 or any(c not in
            "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_"
            for c in token):
        sys.exit("trmx pair: TOKEN must be >=20 chars of url-safe base64")
    cfg = load_config()
    existing = cfg.get("token")
    if existing and not cfg.get("token_generated") and not args.force:
        sys.exit("trmx pair: a token is already paired. Run `trmx unpair` first, "
                 "or use --force to override (rotates the credential).")
    cfg["token"] = token
    cfg["token_generated"] = False
    save_config(cfg)
    print("paired: token stored (never shown again; apps must keep their copy)")
    return 0


def cmd_unpair(args) -> int:
    cfg = load_config()
    if "token" in cfg:
        del cfg["token"]
        cfg.pop("token_generated", None)
        save_config(cfg)
        print("unpaired: token removed — all clients must re-pair")
    else:
        print("unpaired: nothing to do (no token was set)")
    return 0


def cmd_token(args) -> int:
    cfg = load_config()
    tok = cfg.get("token")
    if not tok:
        sys.exit("trmx token: no token configured — run `trmx pair TOKEN` "
                 "or start the bridge once to auto-generate one")
    print(tok if args.show else f"{tok[:4]}…(masked; use --show)")
    return 0


def cmd_pair_link(args) -> int:
    """Open TRMX with THIS bridge's token so the app pairs itself.

    The bridge's token is the auth truth, so the easiest connect is to
    hand it to the app directly: build a trmx://pair?token=… link and
    open it at the app with an explicit-component intent (`am` ships
    with Android and is reachable from Termux). The app adopts the
    token and verifies the connection with a probe — no typing the
    token, no app-side intent, no file write. If `am` is unavailable
    or blocked, print everything needed for the copy-paste path.
    """
    cfg = load_config()
    tok = cfg.get("token")
    if not tok:
        sys.exit("trmx pair-link: no token paired yet — run the app setup "
                 "once, or `trmx pair TOKEN` first")
    uri = f"trmx://pair?token={tok}"
    if args.print_only:
        print(uri)
        return 0
    opened = False
    try:
        r = subprocess.run(
            ["am", "start", "-a", "android.intent.action.VIEW",
             "-n", "dev.trmx.gui/.MainActivity", "-d", uri],
            capture_output=True, text=True, timeout=15)
        opened = r.returncode == 0 and "Error" not in (r.stdout + r.stderr)
    except Exception:  # noqa: BLE001 — any am failure degrades to print
        opened = False
    if opened:
        print("pair-link: opened TRMX — the app will verify the connection itself")
        return 0
    print("pair-link: could not open the app automatically.")
    print("In the TRMX app, open manual pairing and paste this token:")
    print(f"  {tok}")
    print(f"Or open this link on the phone: {uri}")
    return 0


def cmd_start(args) -> int:
    if not BRIDGE.exists():
        sys.exit(f"trmx start: bridge not found at {BRIDGE}")
    home = trmx_home()
    home.mkdir(parents=True, exist_ok=True)
    cfg = load_config()
    port = args.port or int(cfg.get("port", 27342))
    if args.port and int(cfg.get("port", 27342)) != args.port:
        # remember an explicitly chosen port so stop/status find the bridge
        cfg["port"] = args.port
        save_config(cfg)
    if port_open(port):
        print(f"trmx start: something is already listening on 127.0.0.1:{port} — not starting")
        return 1
    log = open(home / "bridge.log", "ab")
    env = dict(os.environ)
    env["TRMX_HOME"] = str(home)
    proc = subprocess.Popen(
        [sys.executable, str(BRIDGE), "--home", str(home), "--port", str(port)],
        stdout=log, stderr=log, stdin=subprocess.DEVNULL,
        start_new_session=True, env=env)
    (home / "bridge.pid").write_text(str(proc.pid))
    for _ in range(100):  # up to 5s for the port to come up
        if port_open(port):
            print(f"trmx start: bridge running on 127.0.0.1:{port} (pid {proc.pid})")
            return 0
        if proc.poll() is not None:
            break
        time.sleep(0.05)
    print(f"trmx start: bridge exited early (code {proc.poll()}); see {home / 'bridge.log'}")
    return 1


def api_stop(cfg: dict, port: int) -> bool:
    tok = cfg.get("token")
    if not tok:
        return False
    try:
        import http.client
        conn = http.client.HTTPConnection("127.0.0.1", port, timeout=3)
        conn.request("POST", "/v1/system/bridge",
                     body=json.dumps({"action": "stop"}),
                     headers={"Authorization": f"Bearer {tok}",
                              "X-TRMX-Protocol": "1",
                              "Content-Type": "application/json"})
        resp = conn.getresponse()
        resp.read()
        conn.close()
        return resp.status == 200
    except Exception:  # noqa: BLE001
        return False


def pid_is_bridge(pid: int) -> bool:
    """Is `pid` really the bridge? (audit §5-M1)

    The pidfile goes stale whenever the bridge dies uncleanly (phantom
    kill, SIGKILL) and pids are recycled — signalling whatever now owns
    the number could kill a stranger process. Verify the identity via
    /proc/<pid>/cmdline (present on Android/Termux and Linux): the
    bridge is always launched as `python… trmx-bridge.py …`. Where
    /proc is unavailable entirely (non-Linux dev hosts), identity
    cannot be checked — keep the historical behaviour there.
    """
    if not Path("/proc").is_dir():
        return True
    try:
        cmdline = Path(f"/proc/{pid}/cmdline").read_bytes()
    except OSError:
        return False   # no such process (or not readable) — not our bridge
    return b"trmx-bridge" in cmdline


def cmd_stop(args) -> int:
    home = trmx_home()
    cfg = load_config()
    port = int(cfg.get("port", 27342))
    pidfile = home / "bridge.pid"
    pid = None
    if pidfile.exists():
        try:
            pid = int(pidfile.read_text().strip())
        except ValueError:
            pid = None
    if api_stop(cfg, port):
        for _ in range(100):
            if not port_open(port, timeout=0.2):
                break
            time.sleep(0.05)
        print("trmx stop: bridge stopped (API)")
        return 0
    if pid and not pid_is_bridge(pid):
        # Audit §5-M1: refuse to signal a stranger. The pidfile is
        # stale; the API stop above already failed, so there is no
        # verified bridge left to stop.
        print(f"trmx stop: pidfile pid {pid} is not the bridge "
              "(stale pidfile?) — refusing to signal it")
        return 1
    if pid:
        import signal
        try:
            os.kill(pid, signal.SIGTERM)
        except ProcessLookupError:
            pass
        for _ in range(100):
            try:
                os.kill(pid, 0)
            except ProcessLookupError:
                print("trmx stop: bridge stopped (SIGTERM)")
                return 0
            time.sleep(0.05)
        try:
            os.kill(pid, signal.SIGKILL)
        except ProcessLookupError:
            pass
        print("trmx stop: bridge killed (SIGKILL after grace)")
        return 0
    print("trmx stop: bridge not running (no pidfile, port closed)")
    return 1


def cmd_status(args) -> int:
    home = trmx_home()
    cfg = load_config()
    port = int(cfg.get("port", 27342))
    pidfile = home / "bridge.pid"
    pid = pidfile.read_text().strip() if pidfile.exists() else "-"
    paired = "paired" if cfg.get("token") else "unpaired"
    print(f"home={home} port={port} pid={pid} token={paired}")
    print(f"data-plane: {'UP' if port_open(port) else 'DOWN'} (127.0.0.1:{port})")
    return 0 if port_open(port) else 1


def cmd_doctor(args) -> int:
    """Self-check for setup/orchestration: python, token, port, API.

    Stdout is pure JSON (the app polls this); a one-line human summary goes
    to stderr. Exit 0 = healthy, 3 = something needs attention.
    """
    home = trmx_home()
    cfg = load_config()
    port = int(cfg.get("port", 27342))
    token = cfg.get("token") or ""
    report: dict = {
        "python": {"present": True,
                   "version": sys.version.split()[0],
                   "exe": sys.executable},
        "home": str(home),
        "token_set": bool(token),
        "port": port,
        "port_open": port_open(port),
        "api_ok": False,
        "bridge_version": None,
    }
    if report["port_open"] and token:
        try:
            import http.client
            conn = http.client.HTTPConnection("127.0.0.1", port, timeout=3)
            conn.request("GET", "/v1/system/info",
                         headers={"Authorization": f"Bearer {token}",
                                  "X-TRMX-Protocol": "1"})
            resp = conn.getresponse()
            body = resp.read()
            conn.close()
            if resp.status == 200:
                report["api_ok"] = True
                try:
                    report["bridge_version"] = json.loads(body).get("bridge_version")
                except Exception:  # noqa: BLE001
                    pass
        except Exception:  # noqa: BLE001
            pass
    if report["api_ok"]:
        verdict = "healthy"
    elif not report["token_set"]:
        verdict = "unpaired"
    elif not report["port_open"]:
        verdict = "bridge_down"
    else:
        verdict = "auth_failed"
    report["verdict"] = verdict
    print(json.dumps(report))
    if verdict == "healthy":
        print(f"trmx doctor: healthy (bridge {report['bridge_version']})",
              file=sys.stderr)
        return 0
    print(f"trmx doctor: {verdict} "
          f"(python={report['python']['version']} "
          f"token={'set' if report['token_set'] else 'MISSING'} "
          f"port={port} {'open' if report['port_open'] else 'closed'} "
          f"api={'ok' if report['api_ok'] else 'FAILED'})", file=sys.stderr)
    return 3


def cmd_pid(args) -> int:
    pidfile = trmx_home() / "bridge.pid"
    if pidfile.exists():
        print(pidfile.read_text().strip())
        return 0
    return 1


def termux_prefix() -> Path:
    return Path(os.environ.get("TRMX_PREFIX", "/data/data/com.termux/files/usr"))


def cmd_enable_boot(args) -> int:
    """Install ~/.termux/boot/trmx-bridge — Termux:Boot runs it after reboot."""
    boot_dir = Path(os.environ.get("TRMX_BOOT_DIR", str(Path.home() / ".termux" / "boot")))
    boot_dir.mkdir(parents=True, exist_ok=True)
    script = boot_dir / "trmx-bridge"
    prefix = termux_prefix()
    home = trmx_home()
    script.write_text(
        f"#!{prefix}/bin/sh\n"
        f"# installed by `trmx enable-boot` — starts the TRMX bridge at boot\n"
        f'export TRMX_HOME="{home}"\n'
        f'exec "{home}/trmx" start >> "{home}/bridge.log" 2>&1\n')
    os.chmod(script, 0o755)
    print(f"boot script installed: {script}")
    print("note: open the Termux:Boot app once so Android allows it to run at boot")
    return 0


def cmd_enable_service(args) -> int:
    """Install the runit service (pkg install termux-services required)."""
    prefix = termux_prefix()
    svdir = prefix / "var" / "service"
    if not svdir.is_dir():
        sys.exit("trmx enable-service: termux-services not found "
                 f"({svdir} missing) — run `pkg install termux-services` first")
    svc = svdir / "trmx-bridge"
    svc.mkdir(parents=True, exist_ok=True)
    run = svc / "run"
    run.write_text(
        f"#!{prefix}/bin/sh\n"
        f"# trmx-bridge runit service (installed by `trmx enable-service`)\n"
        f'export TRMX_HOME="{trmx_home()}"\n'
        f'exec python3 "{trmx_home()}/trmx-bridge.py" 2>&1\n')
    os.chmod(run, 0o755)
    print(f"runit service installed: {run}")
    print("runit will start/restart the bridge automatically (sv up/down trmx-bridge)")
    return 0


def cmd_version(args) -> int:
    print(f"trmx CLI  {TRMX_CLI_VERSION}")
    if BRIDGE.exists():
        m = re.search(r'^VERSION = "([^"]+)"', BRIDGE.read_text("utf-8"), re.M)
        print(f"bridge    {m.group(1) if m else 'unknown'}")
    else:
        print("bridge    not installed (run install.sh)")
    return 0


def _rescue_pair_token(argv):
    """Dash-leading pairing tokens vs argparse.

    A url-safe-base64 token may legitimately START WITH '-'; argparse
    then reads it as an option and `trmx pair -iEu...` fails with a
    usage error (bit the owner on device, 2026-10-18). Token generators
    no longer mint such tokens, but old ones exist — rescue them in ANY
    position: pull the dash-token out and rebuild the canonical form
    `pair [--force] -- TOKEN` before parsing.
    """
    if len(argv) >= 2 and argv[0] == "pair" and "--" not in argv:
        rest = argv[1:]
        for i, a in enumerate(rest):
            if a.startswith("-") and a != "--force" and len(a) >= 20:
                others = rest[:i] + rest[i + 1:]
                return ["pair"] + others + ["--", a]
    return argv


def main() -> None:
    ap = argparse.ArgumentParser(prog="trmx", description="TRMX bridge control CLI")
    sub = ap.add_subparsers(dest="cmd", required=True)
    sub.add_parser("init").set_defaults(fn=cmd_init)
    p = sub.add_parser("pair")
    p.add_argument("token", nargs="?",
                   help="pairing token (omit to read it from stdin, "
                        "keeping it out of shell history — §4-M2)")
    p.add_argument("--force", action="store_true")
    p.add_argument("--stdin", action="store_true",
                   help="read the token from stdin instead of argv")
    p.set_defaults(fn=cmd_pair)
    p = sub.add_parser("pair-link")
    p.add_argument("--print", dest="print_only", action="store_true")
    p.set_defaults(fn=cmd_pair_link)
    sub.add_parser("unpair").set_defaults(fn=cmd_unpair)
    p = sub.add_parser("token")
    p.add_argument("--show", action="store_true")
    p.set_defaults(fn=cmd_token)
    p = sub.add_parser("start")
    p.add_argument("--port", type=int, default=None)
    p.set_defaults(fn=cmd_start)
    sub.add_parser("stop").set_defaults(fn=cmd_stop)
    sub.add_parser("status").set_defaults(fn=cmd_status)
    sub.add_parser("doctor").set_defaults(fn=cmd_doctor)
    sub.add_parser("pid").set_defaults(fn=cmd_pid)
    sub.add_parser("enable-boot").set_defaults(fn=cmd_enable_boot)
    sub.add_parser("enable-service").set_defaults(fn=cmd_enable_service)
    sub.add_parser("version").set_defaults(fn=cmd_version)
    args = ap.parse_args(_rescue_pair_token(sys.argv[1:]))
    sys.exit(args.fn(args))


if __name__ == "__main__":
    main()
