dist/

# android / gradle (CI and Android Studio artifacts — never commit)
.gradle/
build/
local.properties
.idea/
*.iml
.kotlin/
captures/
*.jks
*.keystore
# NO keystore may be committed (audit §4-H2): a public signing key lets
# anyone sign a malicious "update" for the app package. Debug builds use
# the standard per-developer local debug key; distributed builds must use
# release signing (see README "Signing").

