<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Control plane: lets us send RUN_COMMAND intents to Termux.
         Granted by the user in OUR App Info → Permissions (consent screen 2). -->
    <uses-permission android:name="com.termux.permission.RUN_COMMAND" />
    <!-- Required even for loopback sockets: without it, socket() fails with
         EPERM on API 34+ (on-device round 2 lesson, 2026-09-08). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- App Killer: runtime app enumeration for user-confirmed force-stop. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <!-- App Killer: UsageStats access to detect recently active apps on-device. -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- Package visibility (Android 11+): we need to see Termux to check
         it is installed before offering the wizard. -->
    <queries>
        <package android:name="com.termux" />
    </queries>

    <application
        android:name=".TrmxApplication"
        android:label="TRMX"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.TRMX">

        <!-- Phase 8: open/share staged bridge files. Only cache/shared/ is
             exposed, read-only, via explicit URI grants (ADR-008). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="dev.trmx.gui.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Pair-link: `trmx pair-link` in Termux opens
                 trmx://pair?token=… here; MainActivity hands the token
                 to SetupViewModel.adoptFromLink. The scheme is ours
                 alone, so no other app competes for it; the token is
                 verified against the bridge before setup completes. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="trmx" android:host="pair" />
            </intent-filter>
        </activity>

        <!-- App Killer: accessibility service for automating Force Stop in Settings. -->
        <service
            android:name=".killer.AppKillerAccessibilityService"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:label="TRMX App Killer"
            android:exported="true">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>
    </application>
</manifest>
